# Server Configuration
PORT=5000
NODE_ENV=development

# CORS (comma-separated list of allowed origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Database (SQLite for development - can switch to PostgreSQL for production)
DATABASE_URL=file:./dev.db

# JWT Authentication
JWT_SECRET=cranio-jwt-secret-key-2024-change-in-production-abc123xyz789
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=cranio-refresh-token-secret-2024-change-in-production-xyz789abc123
REFRESH_TOKEN_EXPIRES_IN=7d

